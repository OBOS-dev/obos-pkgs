{
    "name": "host-libicu",
    "description": "International Components for Unicode (Host)",
    "version": [ 78,1,0 ],
    "url": "https://github.com/unicode-org/icu/releases/download/release-78.1/icu4c-78.1-sources.tgz",
    "depends": [ "mlibc" ],
    "build-depends": [ "cross-gcc" ],
    "patches": [],
    "bootstrap-commands": [
        [ "${repo_directory}/icu/source/configure","--prefix=${prefix}", "--disable-static", "--enable-shared" ]
    ],
    "build-commands": [
        [ "make", "-j4" ]
    ],
    "install-commands": [
        [ "make", "install", "DESTDIR=${destdir}" ]
    ]
}
