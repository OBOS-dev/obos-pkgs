{
    "name": "svt-av1",
    "description": "AV1 Encoder",
    "version": [ 3,1,2 ],
    "url": "https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v3.1.2/SVT-AV1-v3.1.2.tar.gz",
    "depends": [ "mlibc" ],
    "build-depends": [ "cross-gcc", "cmake-toolchain" ],
    "patches": [],
    "bootstrap-commands": [
        [ "cmake",
          "-B.", "-S${repo_directory}/SVT-AV1-v${version}", 
          "-DCMAKE_INSTALL_PREFIX=${prefix}",
          "-DCMAKE_BUILD_TYPE=Release",
          "-DBUILD_SHARED_LIBS=ON",
          "-DCMAKE_SKIP_INSTALL_RPATH=ON",
          "-GNinja",
          "-Wno-dev",
          "--toolchain=${bootstrap_directory}/toolchain.cmake" ]
    ],
    "build-commands": [
        [ "cmake", "--build", "." ]
    ],
    "install-commands": [
        [ "export", "DESTDIR=${destdir}" ],
        [ "cmake", "--install", "." ],
        [ "export", "DESTDIR=${bin_package_prefix}" ],
        [ "cmake", "--install", "." ]
    ]
}
