{
    "name": "libxaw",
    "description": "god knows",
    "version": [ 1,0,16 ],
    "url": "https://www.x.org/archive/individual/lib/libXaw-1.0.16.tar.xz",
    "depends": [ "mlibc", "libxt", "libxmu", "libxpm", "libxext" ],
    "build-depends": [ "cross-gcc", "xorgproto" ],
    "patches": [],
    "bootstrap-commands": [
        [ "${root_directory}/scripts/do-autoreconf.sh", "${repo_directory}/libXaw-${version}" ],
        [ "${repo_directory}/libXaw-${version}/configure", "--host=${target_triplet}", "--prefix=${prefix}", "--disable-static" ]
    ],
    "build-commands": [
        [ "make" ]
    ],
    "install-commands": [
        [ "make", "install", "DESTDIR=${destdir}" ],
        [ "make", "install", "DESTDIR=${bin_package_prefix}" ]
    ]
}
