{
    "name": "libxpm",
    "description": "...",
    "version": [ 3,5,17 ],
    "url": "https://www.x.org/archive//individual/lib/libXpm-3.5.17.tar.xz",
    "depends": [ "mlibc", "libx11" ],
    "build-depends": [ "cross-gcc", "xorgproto" ],
    "patches": [],
    "bootstrap-commands": [
        [ "${root_directory}/scripts/do-autoreconf.sh", "${repo_directory}/libXpm-${version}" ],
        [ "${repo_directory}/libXpm-${version}/configure", "--host=${target_triplet}", "--prefix=${prefix}", "--disable-malloc0returnsnull", "--disable-static", "--enable-shared" ]
    ],
    "build-commands": [
        [ "make" ]
    ],
    "install-commands": [
        [ "make", "install", "DESTDIR=${destdir}" ],
        [ "make", "install", "DESTDIR=${bin_package_prefix}" ]
    ]
}
