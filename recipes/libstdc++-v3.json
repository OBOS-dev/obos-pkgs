{
    "name": "libstdc++-v3",
    "description": "C++ Standard Library",
    "version": [ 14,2,0 ],
    "depends": [ "mlibc" ],
    "build-depends": [ "cross-gcc>=14.2.0" ],
    "patches": [],
    "bootstrap-commands": [
        [ "${root_directory}/scripts/do-autoreconf.sh", "${repo_directory}/gcc-14.2.0/libstdc++-v3" ],
        [ "${repo_directory}/gcc-14.2.0/libstdc++-v3/configure",
          "--prefix=${prefix}",
          "--host=${target_triplet}",
          "--enable-shared", "--disable-static",
          "--prefix=${prefix}" ]
    ],
    "build-commands": [
        [ "make", "-j${nproc}", "CXXFLAGS=-D_GLIBCXX_HAS_GTHREADS=1" ]
    ],
    "install-commands": [
        [ "make", "-j${nproc}", "install", "DESTDIR=${destdir}", "prefix=${prefix}" ],
        [ "make", "-j${nproc}", "install", "DESTDIR=${bin_package_prefix}", "prefix=${prefix}" ]
    ]
}
